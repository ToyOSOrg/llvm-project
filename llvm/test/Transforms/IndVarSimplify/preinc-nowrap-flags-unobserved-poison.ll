; The nuw on %nextnext makes it poison on the iteration before the last, and
; nothing observes that poison: the loop leaves through %done first. %next's
; add recurrence must not take the flag, or %iter + 1, a defined value that is
; the same SCEV expression, becomes "never zero" and the only exit %iter == -1
; takes folds to false.
; https://github.com/llvm/llvm-project/issues/175729

declare i1 @cond.i8(i8)
declare i1 @cond.i16(i16)
declare i1 @cond.i32(i32)
declare i1 @cond.i64(i64)
declare i1 @cond.i128(i128)

; The start is constant and %done is the loop's only exit.
define i1 @only_exit() {
; CHECK-LABEL: define i1 @only_exit() {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[HEADER:.*]]
; CHECK:       [[HEADER]]:
; CHECK-NEXT:    br i1 true, label %[[EXIT:.*]], label %[[LATCH:.*]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    br label %[[HEADER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i1 true
;
entry:
  br label %header

header:
  %next = phi i16 [ -3, %entry ], [ %nextnext, %latch ]
  %iter = phi i16 [ -4, %entry ], [ %next, %latch ]
  %done = icmp eq i16 %iter, -1
  br i1 %done, label %exit, label %latch

latch:
  %nextnext = add nuw i16 %next, 1
  br label %header

exit:
  ret i1 true
}

