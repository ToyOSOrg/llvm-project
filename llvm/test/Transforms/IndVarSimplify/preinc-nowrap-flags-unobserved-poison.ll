; The loop rustc's RangeInclusive<u16> made of `for port in 0xFFFC..=0xFFFF`,
; where the miscompile was found.
define i1 @probe() {
; CHECK-LABEL: define i1 @probe() {
; CHECK-NEXT:  [[START:.*]]:
; CHECK-NEXT:    br label %[[HEADER:.*]]
; CHECK:       [[HEADER]]:
; CHECK-NEXT:    [[NEXT:%.*]] = phi i16 [ -3, %[[START]] ], [ [[NEXTNEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[ITER:%.*]] = phi i16 [ -4, %[[START]] ], [ [[NEXT]], %[[LATCH]] ]
; CHECK-NEXT:    switch i16 [[ITER]], label %[[MASK:.*]] [
; CHECK-NEXT:      i16 161, label %[[EXIT:.*]]
; CHECK-NEXT:      i16 160, label %[[EXIT]]
; CHECK-NEXT:      i16 113, label %[[EXIT]]
; CHECK-NEXT:      i16 112, label %[[EXIT]]
; CHECK-NEXT:      i16 33, label %[[EXIT]]
; CHECK-NEXT:      i16 32, label %[[EXIT]]
; CHECK-NEXT:      i16 3320, label %[[EXIT]]
; CHECK-NEXT:      i16 3321, label %[[EXIT]]
; CHECK-NEXT:      i16 178, label %[[LATCH]]
; CHECK-NEXT:    ]
; CHECK:       [[MASK]]:
; CHECK-NEXT:    [[M:%.*]] = and i16 [[ITER]], -4
; CHECK-NEXT:    [[C1:%.*]] = icmp eq i16 [[M]], 3324
; CHECK-NEXT:    br i1 [[C1]], label %[[EXIT]], label %[[LAST:.*]]
; CHECK:       [[LAST]]:
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i16 [[ITER]], -1
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT]], label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[NEXTNEXT]] = add nuw i16 [[NEXT]], 1
; CHECK-NEXT:    [[M2:%.*]] = and i16 [[NEXT]], -8
; CHECK-NEXT:    [[C2:%.*]] = icmp eq i16 [[M2]], 1016
; CHECK-NEXT:    br i1 [[C2]], label %[[EXIT]], label %[[HEADER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[R:%.*]] = phi i1 [ false, %[[MASK]] ], [ false, %[[HEADER]] ], [ false, %[[HEADER]] ], [ false, %[[LATCH]] ], [ false, %[[HEADER]] ], [ false, %[[HEADER]] ], [ false, %[[HEADER]] ], [ false, %[[HEADER]] ], [ false, %[[HEADER]] ], [ false, %[[HEADER]] ], [ true, %[[LAST]] ]
; CHECK-NEXT:    ret i1 [[R]]
;
start:
  br label %header

header:
  %next = phi i16 [ -3, %start ], [ %nextnext, %latch ]
  %iter = phi i16 [ -4, %start ], [ %next, %latch ]
  switch i16 %iter, label %mask [
  i16 161, label %exit
  i16 160, label %exit
  i16 113, label %exit
  i16 112, label %exit
  i16 33, label %exit
  i16 32, label %exit
  i16 3320, label %exit
  i16 3321, label %exit
  i16 178, label %latch
  ]

mask:
  %m = and i16 %iter, -4
  %c1 = icmp eq i16 %m, 3324
  br i1 %c1, label %exit, label %last

last:
  %done = icmp eq i16 %iter, -1
  br i1 %done, label %exit, label %latch

latch:
  %nextnext = add nuw i16 %next, 1
  %m2 = and i16 %next, -8
  %c2 = icmp eq i16 %m2, 1016
  br i1 %c2, label %exit, label %header

exit:
  %r = phi i1 [ false, %mask ], [ false, %header ], [ false, %header ], [ false, %latch ], [ false, %header ], [ false, %header ], [ false, %header ], [ false, %header ], [ false, %header ], [ false, %header ], [ true, %last ]
  ret i1 %r
}
