; The use of %nextnext does not dominate the latch: a backedge can be taken
; with %nextnext poison.
define i1 @increment_observed_on_one_path(i16 %start) {
; CHECK-LABEL: 'increment_observed_on_one_path'
; CHECK-NEXT:  Classifying expressions for: @increment_observed_on_one_path
; CHECK-NEXT:    %next = phi i16 [ %start, %entry ], [ %nextnext, %latch ]
; CHECK-NEXT:    --> {%start,+,1}<%header> U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %header: Computable }
; CHECK-NEXT:    %c = call i1 @cond(i16 0)
; CHECK-NEXT:    --> %c U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %header: Variant }
; CHECK-NEXT:    %nextnext = add nuw i16 %next, 1
; CHECK-NEXT:    --> {(1 + %start),+,1}<%header> U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %header: Computable }
; CHECK-NEXT:    %c2 = call i1 @cond(i16 1)
; CHECK-NEXT:    --> %c2 U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %header: Variant }
; CHECK-NEXT:  Determining loop execution counts for: @increment_observed_on_one_path
; CHECK-NEXT:  Loop %header: Unpredictable backedge-taken count.
; CHECK-NEXT:  Loop %header: Unpredictable constant max backedge-taken count.
; CHECK-NEXT:  Loop %header: Unpredictable symbolic max backedge-taken count.
;
entry:
